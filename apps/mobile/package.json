{
  "name": "@sonder/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "expo export",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "eas:init": "eas init",
    "eas:login": "eas login",
    "lint": "eslint App.tsx src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@sonder/shared": "workspace:*",
    "expo": "^52.0.23",
    "expo-dev-client": "~5.0.20",
    "expo-location": "~18.0.5",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "eas-cli": "^18.11.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
