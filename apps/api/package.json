{
  "name": "@sonder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:lambda": "pnpm dlx @opennextjs/aws@latest build",
    "db:deploy": "prisma migrate deploy --schema src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema src/prisma/schema.prisma",
    "dev": "next dev -p 3000",
    "lint": "eslint src",
    "start": "next start -p 3000",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint": "^3.726.1",
    "@prisma/client": "^5.22.0",
    "@sonder/shared": "workspace:*",
    "jose": "^5.9.6",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx src/prisma/seed.ts"
  }
}
